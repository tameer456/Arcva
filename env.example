# Arcva MCP Server — Environment Variables
# Copy this file to .env and fill in your values

# Your Anthropic API key (for the business advisor tool)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OAuth client credentials (you define these when submitting to Anthropic)
OAUTH_CLIENT_ID=arcva_mcp_client
OAUTH_CLIENT_SECRET=your_secret_here

# Server port (default 3000)
PORT=3000

# Base44 App ID (already set in code, listed here for reference)
BASE44_APP_ID=6a1e7db0584fc5296b3417c8
